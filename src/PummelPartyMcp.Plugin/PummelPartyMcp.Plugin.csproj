<Project Sdk="Microsoft.NET.Sdk">

  <!--
    pummel-party-mcp BepInEx plugin (Phase 2: read tools, guarded write tools, Workshop publish block).

    Game assemblies are referenced from the local install and never copied to the output.
    Override the install location with either:
      dotnet build -c Release -p:GameDir="D:\Games\Pummel Party"
    or an untracked file next to this project named PummelPartyMcp.Plugin.csproj.user:
      <Project><PropertyGroup><GameDir>D:\Games\Pummel Party</GameDir></PropertyGroup></Project>
    (MSBuild imports "<project>.user" automatically; *.user is gitignored.)
    Item includes below use $(GameDir) directly, so a value set in the .user file wins.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>PummelPartyMcp.Plugin</AssemblyName>
    <RootNamespace>PummelPartyMcp</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <Version>0.7.0</Version>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Pummel Party</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\PummelParty_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Facade (type forwards); BepInEx.dll is compiled against it. -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\PummelParty_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\PummelParty_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameDir)\PummelParty_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(GameDir)\PummelParty_Data\Managed\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Input.GetMouseButton: the editor defers undo snapshots while the left mouse button is held. -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\PummelParty_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameDir)\PummelParty_Data\Managed\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameDir)\PummelParty_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- HarmonyX (shipped with BepInEx) for the Workshop publish block. -->
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Steamworks types appear in Assembly-CSharp signatures; patch targets themselves are resolved by name. -->
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameDir)\PummelParty_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
