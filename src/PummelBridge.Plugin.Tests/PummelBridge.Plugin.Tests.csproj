<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console test harness for the Unity-free HTTP/auth/dispatch layer (Core/). It compiles the plugin's Core
    sources directly, so no game, Unity or BepInEx assembly is needed. Run: dotnet run -c Release
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\PummelBridge.Plugin\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
