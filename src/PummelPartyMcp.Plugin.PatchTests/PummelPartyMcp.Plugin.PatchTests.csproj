<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harmony test for the Workshop publish-block helper (Safety/PublishBlocker.cs) against stand-in static methods.
    net472 on purpose: the HarmonyX 2.9 / MonoMod build shipped with BepInEx 5.4.23 throws in AccessTools' static
    constructor under .NET 8, so this cannot live in the net8.0 harness. Runs on the Windows .NET Framework 4.x CLR.
    0Harmony and its MonoMod/Cecil dependencies are referenced from the local game install and copied to bin/
    (gitignored), never into the repo. GameDir is resolved in src/Directory.Build.props (-p:GameDir="...", or src/GameDir.props.user, or the standard Steam location).
    Run: dotnet run -c Release
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RequiresGameDir>true</RequiresGameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PummelPartyMcp.Plugin\Safety\PublishBlocker.cs" Link="Safety\PublishBlocker.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Safety\PublishBlockMonitor.cs" Link="Safety\PublishBlockMonitor.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Safety\PublishBlockTargets.cs" Link="Safety\PublishBlockTargets.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Core\RpcErrors.cs" Link="Core\RpcErrors.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Core\PublishBlockStatus.cs" Link="Core\PublishBlockStatus.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Hooks\SaveWatch.cs" Link="Hooks\SaveWatch.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Hooks\ModSwitchGuard.cs" Link="Hooks\ModSwitchGuard.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Hooks\PatchRemoval.cs" Link="Hooks\PatchRemoval.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Core\RequiredMembers.cs" Link="Core\RequiredMembers.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Core\InspectorRules.cs" Link="Core\InspectorRules.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Core\SettingsRules.cs" Link="Core\SettingsRules.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Core\AssetSettingsRules.cs" Link="Core\AssetSettingsRules.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Core\AssetImportCore.cs" Link="Core\AssetImportCore.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Core\TestModName.cs" Link="Core\TestModName.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Core\SandboxPath.cs" Link="Core\SandboxPath.cs" />
    <Compile Include="..\PummelPartyMcp.Plugin\Core\AudioHeaders.cs" Link="Core\AudioHeaders.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The drift test (GameDriftTest.cs) reads the game assemblies from here, for reflection only; nothing is copied. -->
    <AssemblyMetadata Include="GameDir" Value="$(GameDir)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath></Reference>
    <Reference Include="MonoMod.RuntimeDetour"><HintPath>$(GameDir)\BepInEx\core\MonoMod.RuntimeDetour.dll</HintPath></Reference>
    <Reference Include="MonoMod.Utils"><HintPath>$(GameDir)\BepInEx\core\MonoMod.Utils.dll</HintPath></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(GameDir)\BepInEx\core\Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>

</Project>
