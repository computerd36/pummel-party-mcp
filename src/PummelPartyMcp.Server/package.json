{
  "name": "pummel-party-mcp",
  "version": "0.7.0",
  "description": "MCP server for Pummel Party's built-in Mod Editor: connects an AI agent to the pummel-party-mcp BepInEx plugin (loopback only, sandbox mods only). Unofficial.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "pummel-party-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "//": "private stays true until the author decides to publish.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/computerd36/pummel-party-mcp.git",
    "directory": "src/PummelPartyMcp.Server"
  },
  "homepage": "https://github.com/computerd36/pummel-party-mcp#readme",
  "bugs": {
    "url": "https://github.com/computerd36/pummel-party-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pummel-party",
    "mod-editor",
    "bepinex",
    "unity"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
